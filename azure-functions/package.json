{
  "name": "copilot-azure-functions",
  "version": "1.0.0",
  "description": "Azure Functions backend for GitHub Copilot SDK integration",
  "type": "module",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "clean": "rimraf dist",
    "start": "func start",
    "start:debug": "func start --javascript --language-worker=\"--inspect=9229\"",
    "prestart": "npm run build"
  },
  "dependencies": {
    "@azure/functions": "^4.5.0",
    "@github/copilot-sdk": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.x",
    "azure-functions-core-tools": "^4.x",
    "rimraf": "^5.0.5",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0 <24.0.0"
  }
}
